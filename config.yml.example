# OpenRouter Proxy Configuration
#
# This proxy supports bidirectional protocol translation:
#   - Client can send OpenAI format (/v1/chat/completions) or Anthropic format (/v1/messages)
#   - Upstream can be OpenAI-compatible or Anthropic Messages API
#   - Translation happens automatically based on upstream_format setting
#
# Translation matrix:
#   Client OpenAI    → upstream_format: "openai"     → passthrough
#   Client OpenAI    → upstream_format: "anthropic"  → translate + spoof Claude Code headers
#   Client OpenAI    → upstream_format: "gemini"     → translate to Gemini
#   Client Anthropic → upstream_format: "openai"     → translate to OpenAI, send, translate back
#   Client Anthropic → upstream_format: "anthropic"  → strip prefix, spoof headers, passthrough
#   Client Anthropic → upstream_format: "gemini"     → translate to Gemini
#   Client Gemini    → upstream_format: "openai"     → translate to OpenAI, send, translate back
#   Client Gemini    → upstream_format: "anthropic"  → translate to Anthropic, send, translate back
#   Client Gemini    → upstream_format: "gemini"     → passthrough
#   Client Responses → upstream_format: "openai"     → passthrough (Responses API)
#   Client Responses → upstream_format: "anthropic"  → translate to Anthropic
#   Client Responses → upstream_format: "gemini"     → translate to Gemini

# Server settings
server:
  host: "127.0.0.1"  # Only local connections; use "0.0.0.0" to expose to all network interfaces
  port: 5555  # Default port
  access_key: "your_local_access_key_here"  # WARNING: MUST be changed before deployment
  log_level: "INFO"  # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
  http_log_level: "INFO"  # HTTP access logs level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# Provider registry
# Each provider defines an upstream API endpoint with its own keys, models, and protocol.
# Models are always requested as <provider>/<model> from the client side.
providers:

  # ─── OpenAI-compatible upstream (default mode) ──────────────────────────────
  openrouter:
    base_url: "https://openrouter.ai/api/v1"
    # upstream_format: "openai"  # default, can be omitted
    keys:
      - "sk-or-...-key1"
      - "sk-or-...-key2"

    # Only these models may be requested by clients.
    # Every entry must be provider-qualified as <provider>/<model>.
    allowed_models:
      - "openrouter/deepseek/deepseek-r1:free"
      - "openrouter/google/gemma-4-31b-it:free"
      - "openrouter/openai/gpt-oss-120b:free"

    # Key selection strategy: "round-robin" (default), "first" or "random".
    key_selection_strategy: "round-robin"
    # Key selection options:
    #   "same": Always reuse the last used key as long as possible.
    key_selection_opts: []

    # Public endpoints that don't require client authentication
    public_endpoints:
      - "/models"

    # Time in seconds to temporarily disable a key when rate limit is reached
    rate_limit_cooldown: 14400  # 4 hours

    # Only show free models in /models listing
    free_only: false

    # Minimum delay between upstream requests (seconds). Prevents 429 storms.
    # Set to 0 to disable request pacing.
    global_rate_delay: 8

  # ─── Another OpenAI-compatible upstream ─────────────────────────────────────
  openai:
    base_url: "https://api.openai.com/v1"
    # upstream_format: "openai"  # default
    keys:
      - "sk-proj-...-key"
    allowed_models:
      - "openai/gpt-4o"
      - "openai/o3-mini"
    key_selection_strategy: "round-robin"
    key_selection_opts: []
    public_endpoints:
      - "/models"
    rate_limit_cooldown: 14400
    global_rate_delay: 0

  # ─── Local Ollama (no auth needed) ──────────────────────────────────────────
  ollama:
    base_url: "http://127.0.0.1:11434/v1"
    keys: []  # Ollama doesn't need auth
    allowed_models:
      - "ollama/llama3.1"
      - "ollama/qwen2.5:14b"
    key_selection_strategy: "round-robin"
    key_selection_opts: []
    public_endpoints:
      - "/models"
    rate_limit_cooldown: 14400
    global_rate_delay: 0
    supports_stateful_responses: false

  # ─── Anthropic upstream (AgentRouter) — Full Claude Code Spoof ──────────────
  # Translates OpenAI requests → Anthropic Messages format,
  # spoofs Claude Code client fingerprint to bypass AgentRouter's client detection.
  agentrouter:
    base_url: "https://agentrouter.org"
    upstream_format: "anthropic"

    # Anthropic-specific settings
    upstream_messages_path: "/v1/messages?beta=true"
    model_prefix: "agentrouter/"
    default_max_tokens: 4096
    inject_billing: true                     # Required by AgentRouter — injects
                                             # billing trace into system prompt text

    # ─── Reasoning / Thinking configuration ──────────────────────────────
    # reasoning_mode controls how the proxy injects thinking parameters upstream.
    # Supported modes:
    #   "openai_reasoning"     → reasoning: {effort: "high"}       (OpenAI, OpenRouter, most APIs)
    #   "anthropic_thinking"   → thinking: {type: "enabled", ...}  (Anthropic, AgentRouter)
    #   "enable_thinking_flag" → enable_thinking: true             (Alibaba DashScope, some providers)
    #   "chat_template"        → chat_template_kwargs.enable_thinking: true  (HuggingFace TGI, vLLM)
    #   "" (empty/omit)       → don't inject, client controls it
    reasoning_mode: "anthropic_thinking"

    # reasoning_effort sets the default effort when client doesn't specify one.
    # Budget mapping: minimal→512, low→1024, medium→4096, high→16384, xhigh→32768
    # Omit or set to "" to let client control reasoning entirely.
    # reasoning_effort: "medium"

    keys:
      - "sk-your-agentrouter-key"
    allowed_models:
      - "agentrouter/glm-5.1"
      - "agentrouter/deepseek-v4-flash"
      - "agentrouter/deepseek-v4-pro"
      - "agentrouter/claude-opus-4-6"
      - "agentrouter/claude-haiku-4-5-20251001"
    key_selection_strategy: "first"
    key_selection_opts: []
    public_endpoints:
      - "/models"
    rate_limit_cooldown: 14400
    global_rate_delay: 5

    # ─── Full Claude Code fingerprint ──────────────────────────────────────
    # All fields override FINGERPRINT_DEFAULTS in protocol_adapter.py.
    # Omit any field to use the built-in default.
    fingerprint:
      anthropic_version: "2023-06-01"
      anthropic_beta: "claude-code-20250219,interleaved-thinking-2025-05-14,context-management-2025-06-27,prompt-caching-scope-2026-01-05,advisor-tool-2026-03-01,effort-2025-11-24"
      user_agent: "claude-cli/2.1.145 (external, sdk-cli)"
      anthropic_browser_access: "true"       # → anthropic-dangerous-direct-browser-access
      x_app: "cli"

      # Stainless SDK fingerprint (Node.js — matches Claude Code runtime)
      stainless_arch: "x64"
      stainless_lang: "js"
      stainless_os: "Linux"                  # "Windows" / "MacOS" — match target platform
      stainless_package_version: "0.93.0"
      stainless_runtime: "node"
      stainless_runtime_version: "v24.15.0"  # must be valid Node version string
      stainless_timeout: "600"               # 600s matches real Claude Code

      # Billing header: empty string = compute dynamic cch from user message.
      # Set to a static value like "x-anthropic-billing-header: cc_version=2.1.145.560; cc_entrypoint=sdk-cli; cch=00000;"
      # to bypass per-request computation.
      billing_header: ""

    # ─── Custom headers (highest priority, overrides fingerprint) ─────────
    custom_headers:
      x-stainless-helper-method: "stream"    # present in real Claude Code requests
      x-stainless-retry-count: "0"           # base request, not a retry
      x-stainless-timeout: "600"

  # ─── Custom OpenAI-compatible provider ──────────────────────────────────────
  # Any OpenAI-compatible API can be added as a provider.
  # mimo:
  #   base_url: "https://token-plan-sgp.xiaomimimo.com/v1"
  #   # upstream_format: "openai"  # default
  #   keys:
  #     - "tp-your-mimo-key"
  #   allowed_models:
  #     - "mimo/mimo-v2.5-pro"
  #   key_selection_strategy: "first"
  #   key_selection_opts: []
  #   public_endpoints:
  #     - "/models"
  #   rate_limit_cooldown: 14400
  #   global_rate_delay: 5

  # ─── Another Anthropic upstream example ─────────────────────────────────────
  # You can add multiple anthropic-format providers with different fingerprints.
  # anthropic-direct:
  #   base_url: "https://api.anthropic.com"
  #   upstream_format: "anthropic"
  #   upstream_messages_path: "/v1/messages"
  #   model_prefix: "anthropic-direct/"
  #   default_max_tokens: 8192
  #   inject_billing: false  # Not needed for direct Anthropic API
  #   keys:
  #     - "sk-ant-your-key"
  #   allowed_models:
  #     - "anthropic-direct/claude-sonnet-4-20250514"
  #   fingerprint:
  #     user_agent: "my-app/1.0"  # Override user agent
  #   custom_headers:
  #     anthropic-dangerous-direct-browser-access: "true"

  # ─── Gemini upstream (native GenerateContent API) ─────────────────────────
  # gemini:
  #   base_url: "https://generativelanguage.googleapis.com"
  #   upstream_format: "gemini"
  #   gemini_api_version: "v1beta"
  #   model_prefix: "gemini/"
  #   default_max_tokens: 8192
  #   keys:
  #     - "your-gemini-api-key"
  #   allowed_models:
  #     - "gemini/gemini-2.0-flash"
  #     - "gemini/gemini-2.5-pro"
  #   key_selection_strategy: "round-robin"
  #   key_selection_opts: []
  #   public_endpoints:
  #     - "/models"
  #   rate_limit_cooldown: 14400
  #   global_rate_delay: 5

# Proxy settings for outgoing requests (SOCKS5/HTTP proxy for all upstream calls)
requestProxy:
  enabled: false  # Set to true to enable proxy
  url: "socks5://username:password@example.com:1080"  # Proxy URL with optional credentials
